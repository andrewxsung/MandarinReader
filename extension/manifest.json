{
  "manifest_version": 3,
  "name": "MandarinReader",
  "version": "0.2.0",
  "description": "Capture Traditional Chinese vocabulary from pages you visit and build your personal learning queue.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://mandarinreader-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MandarinReader — Capture this page"
  }
}
